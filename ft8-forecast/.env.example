# Copy to .env (gitignored) and fill in. Used by `ft8cast forecast` for distances.
# Your 4-character Maidenhead grid square (e.g. FN31). 4 characters keeps your location coarse.
MY_GRID=AA00

# Optional: the folder with your ALL.TXT and wsjtx_log.adi, for `ft8cast import` with no
# file, `ft8cast watch`, and the page's "Import from folder" button. Only read, never
# written. ~ works; a relative path is relative to this file. In WSJT-X, File > Open log
# directory shows where the files are; for another computer, mount that folder as a share.
# LOG_DIR=/Volumes/WSJT-X
